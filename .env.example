# Copiar a .env y completar. .env NUNCA se sube a git.

# PostgreSQL (docker-compose.yml)
POSTGRES_USER=sart
POSTGRES_PASSWORD=cambiar-esta-clave
POSTGRES_DB=sart
# Si 5432 está ocupado (p. ej. un PostgreSQL instalado en el equipo), usar 5433 aquí y en DATABASE_URL.
POSTGRES_PORT=5432

# Backend (debe coincidir con lo de arriba). La API lee este archivo sola (sart/configuracion.py).
# Usar 127.0.0.1 y no localhost: en Windows localhost prueba primero IPv6 (::1), donde la base no escucha,
# y cada conexión espera varios segundos o se cuelga.
DATABASE_URL=postgresql+psycopg://sart:cambiar-esta-clave@127.0.0.1:5432/sart

# Firma de los JWT (RNF-S-1). Generar uno propio, por ejemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambiar-esto

# Cookie de sesión solo por HTTPS (RNF-S-3). En desarrollo local (http) poner false; en producción, true.
COOKIE_SEGURA=false

# Solo para probar en local: código MFA fijo de 6 dígitos para los administradores, además del de la app
# (pendientes #49). Es el de las cuentas demo (python -m sart.demo preparar). Se ignora si COOKIE_SEGURA=true.
# En producción: borrar esta línea.
MFA_CODIGO_DESARROLLO=123456

# Ruta de los parámetros (RNF-M-4). Si se omite, se usa config/parametros.yaml
# SART_PARAMETROS=config/parametros.yaml
